{
  "name": "living-code-aider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Living Code for Aider: native UI colors and Neovim-aligned code highlighting through a companion Pygments plugin.",
  "license": "MIT",
  "author": "Living Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/living-code-theme/aider.git"
  },
  "homepage": "https://living-code.dev/ports/aider/",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.22"
  },
  "livingCode": {
    "kind": "files"
  },
  "scripts": {
    "build": "node scripts/generate.mjs && python3 scripts/build-wheel.py",
    "check": "node scripts/check.mjs && python3 scripts/capture.py --check",
    "test": "node scripts/check.mjs && node --test test/*.test.mjs",
    "screenshots": "nix develop path:./capture --command python3 scripts/capture.py",
    "screenshots:check": "python3 scripts/capture.py --check",
    "check:generated": "node scripts/generate.mjs --check && python3 scripts/build-wheel.py --check",
    "palette:update": "node scripts/update-palette.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
